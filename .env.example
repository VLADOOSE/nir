# Скопируй в .env на сервере (/srv/ais/.env) и заполни. В git .env НЕ коммитить!
# ---------------------------------------------------------------------------

# --- БД (внутренний Postgres АИС) ---
POSTGRES_USER=nir
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Почта: отправка КП (боевой SMTP mail.ru, ящик zakup@westmed.kz) ---
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=zakup@westmed.kz
MAIL_PASSWORD=CHANGE_ME_mailru_app_password   # пароль ПРИЛОЖЕНИЯ mail.ru, не основной
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
MAIL_KP_REPLY_TO=zakup@westmed.kz

# --- Почта: приём ящика zakup@ (IMAP). Ящик только читается — письма у людей остаются непрочитанными.
# Включение — отдельным шагом после деплоя (DEPLOY.md §8) ---
MAIL_IMAP_ENABLED=false
MAIL_IMAP_HOST=imap.mail.ru
MAIL_IMAP_PORT=993
MAIL_IMAP_PROTOCOL=imaps
MAIL_IMAP_USERNAME=zakup@westmed.kz
MAIL_IMAP_PASSWORD=CHANGE_ME_mailru_app_password   # тот же пароль приложения, что MAIL_PASSWORD (доступ IMAP + SMTP)
MAIL_IMAP_MARKET=KZ
MAIL_IMAP_SINCE_MINUTES=60        # окно ПЕРВОГО запуска (курсора нет / сменился UIDVALIDITY); дальше — курсор по UID
MAIL_IMAP_POLL_MS=60000           # опрос ящика раз в минуту
MAIL_IMAP_CLIENT_REQUESTS=false   # zakup@: Excel без метки [КП-…] — прайс поставщика, не «Письмо клиники» (для info@ — true)

# --- Уведомления о письмах zakup@ в Telegram (группа «Заявки», тема «Почта zakup@»; DEPLOY.md §8) ---
# Токен стоит в ПУТИ адреса Bot API — нигде не печатать. TELEGRAM_API_URL НЕ задавать: пустое значение умолчанием
# (https://api.telegram.org) не заменяется — ни одно уведомление не уйдёт. Ссылки «Открыть в АИС» на проде —
# https://ais.westmed.kz из application-prod.yaml (AIS_PUBLIC_URL не нужен).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME_bot_token          # тот же бот @West_Med_bot, что у сайта (app_settings.telegram_bot_token)
TELEGRAM_CHAT_ID=-1004352219740                 # группа «Заявки»
TELEGRAM_MAIL_THREAD_ID=CHANGE_ME_topic_id      # id темы «Почта zakup@» — только цифры (из ссылки https://t.me/c/4352219740/<id>)

# --- Госзакуп РК (импорт KZ-тендеров + разбор ТЗ). Токен протухает — перевыпускать ---
GOSZAKUP_TOKEN=CHANGE_ME_goszakup_token
GOSZAKUP_IMPORT_ENABLED=false     # авто-поллинг раз в 6ч; кнопка «Обновить» работает и без этого
SKPHARMACY_IMPORT_ENABLED=false

# --- Обращения: приём заявок с сайта westmed.kz (API админки сайта, код сайта не меняется) ---
# Учётка АИС на сайте создаётся одной строкой в его БД (спека §13). Пароль — только здесь.
WESTMED_LEADS_ENABLED=false
WESTMED_BASE_URL=https://westmed.kz
WESTMED_USERNAME=ais@westmed.kz
WESTMED_PASSWORD=CHANGE_ME_westmed_integration_password
WESTMED_WRITE_STATUS=true

# --- Чаты WhatsApp (зеркало переписки рабочего номера; DEPLOY.md §7) ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=waha            # waha — свой шлюз в Docker (по умолчанию); greenapi — запасной
WHATSAPP_MAX_FILE_MB=25
# WAHA: оба ключа — `openssl rand -hex 32` прямо на сервере, в чат не печатать.
# COMPOSE_PROFILES=whatsapp запускает контейнер ais-waha (без этой строки обычный деплой WAHA не поднимает).
WHATSAPP_WAHA_API_KEY=CHANGE_ME_openssl_rand_hex_32
WHATSAPP_WAHA_HMAC_KEY=CHANGE_ME_openssl_rand_hex_32
#COMPOSE_PROFILES=whatsapp
# Green-API (запасной, WHATSAPP_PROVIDER=greenapi): инстанс Business, адрес вебхука в кабинете — ПУСТОЙ.
# Токен стоит в пути URL запросов — нигде не печатать.
WHATSAPP_API_URL=CHANGE_ME_apiUrl_from_green_api_cabinet   # вида https://7105.api.greenapi.com
WHATSAPP_ID_INSTANCE=CHANGE_ME_idInstance
WHATSAPP_API_TOKEN=CHANGE_ME_apiTokenInstance
