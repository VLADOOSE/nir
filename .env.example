# Скопируй в .env на сервере (/srv/ais/.env) и заполни. В git .env НЕ коммитить!
# ---------------------------------------------------------------------------

# --- БД (внутренний Postgres АИС) ---
POSTGRES_USER=nir
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Почта: отправка КП (боевой SMTP mail.ru, ящик zakup@westmed.kz) ---
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=zakup@westmed.kz
MAIL_PASSWORD=CHANGE_ME_mailru_app_password   # пароль ПРИЛОЖЕНИЯ mail.ru, не основной
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
MAIL_KP_REPLY_TO=zakup@westmed.kz

# --- Почта: приём ящика zakup@ (IMAP). Ящик только читается — письма у людей остаются непрочитанными.
# Включение — отдельным шагом после деплоя (DEPLOY.md §8) ---
MAIL_IMAP_ENABLED=false
MAIL_IMAP_HOST=imap.mail.ru
MAIL_IMAP_PORT=993
MAIL_IMAP_PROTOCOL=imaps
MAIL_IMAP_USERNAME=zakup@westmed.kz
MAIL_IMAP_PASSWORD=CHANGE_ME_mailru_app_password   # тот же пароль приложения, что MAIL_PASSWORD (доступ IMAP + SMTP)
MAIL_IMAP_MARKET=KZ
MAIL_IMAP_SINCE_MINUTES=60        # окно ПЕРВОГО запуска (курсора нет / сменился UIDVALIDITY); дальше — курсор по UID
MAIL_IMAP_POLL_MS=60000           # опрос ящика раз в минуту
MAIL_IMAP_CLIENT_REQUESTS=false   # zakup@: Excel без метки [КП-…] — прайс поставщика, не «Письмо клиники» (для info@ — true)

# --- Почта: письма клиентов на info@ → «Обращения» (второй ящик, только чтение; DEPLOY.md §10) ---
# Telegram об info@ АИС не шлёт — это делает medsite. Пустыми ключи не оставлять: пустое число или флаг валит старт.
MAIL_CLIENTS_ENABLED=false
MAIL_CLIENTS_HOST=imap.mail.ru
MAIL_CLIENTS_PORT=993
MAIL_CLIENTS_PROTOCOL=imaps
MAIL_CLIENTS_USERNAME=info@westmed.kz
MAIL_CLIENTS_PASSWORD=CHANGE_ME_mailru_app_password   # пароль приложения info@ (доступ IMAP)
MAIL_CLIENTS_MARKET=KZ
MAIL_CLIENTS_SINCE_DAYS=7          # окно ПЕРВОГО запуска папки; дальше — курсор по UID
MAIL_CLIENTS_SMTP_HOST=                # письма клиентам из АИС: smtp.mail.ru (пусто — отправка выключена); вход — MAIL_CLIENTS_USERNAME / PASSWORD
MAIL_CLIENTS_SMTP_PORT=465
MAIL_CLIENTS_SMTP_SSL=true             # пустым не оставлять — пустой булев флаг роняет старт
MAIL_CLIENTS_FROM_NAME=West-Med        # имя в строке «От»
MAIL_CLIENTS_SENT_COPY_ENABLED=true    # копия письма клиенту — в «Отправленные» info@ (IMAP APPEND)

# --- Уведомления о письмах zakup@ в Telegram (группа «Заявки», тема «Почта zakup@»; DEPLOY.md §8) ---
# Токен стоит в ПУТИ адреса Bot API — нигде не печатать. TELEGRAM_API_URL НЕ задавать: пустое значение умолчанием
# (https://api.telegram.org) не заменяется — ни одно уведомление не уйдёт. Ссылки «Открыть в АИС» на проде —
# https://ais.westmed.kz из application-prod.yaml (AIS_PUBLIC_URL не нужен).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME_bot_token          # тот же бот @West_Med_bot, что у сайта (app_settings.telegram_bot_token)
TELEGRAM_CHAT_ID=-1004352219740                 # группа «Заявки»
TELEGRAM_MAIL_THREAD_ID=CHANGE_ME_topic_id      # id темы «Почта zakup@» — только цифры (из ссылки https://t.me/c/4352219740/<id>)

# --- Госзакуп РК (импорт KZ-тендеров + разбор ТЗ). Токен протухает — перевыпускать ---
GOSZAKUP_TOKEN=CHANGE_ME_goszakup_token
# Автозапуск импорта в рабочие часы (goszakup ежечасно, СК-Фармация трижды в день; DEPLOY.md §9) и уведомление
# о новых тендерах ЗКО в Telegram (тема «Тендеры»). Кнопка «Обновить тендеры» работает и без этого.
TENDERS_AUTO_IMPORT_ENABLED=false
TENDERS_NOTIFY_ENABLED=false
TELEGRAM_TENDERS_THREAD_ID=CHANGE_ME_topic_id   # id темы «Тендеры» — только цифры (из ссылки https://t.me/c/4352219740/<id>)
# Наша продукция в тендерах по всей стране (поиск goszakup по словам групп, планы закупок; DEPLOY.md «Наша продукция»).
# Сообщения — в свою тему «Тендеры (наши товары)» (пусто — в тему «Тендеры»); по умолчанию только «★» и только если наши
# лоты тендера — от 1 000 000 ₸ (PRODUCT_WATCH_NOTIFY=ALL|STAR|OFF, PRODUCT_WATCH_NOTIFY_MIN_SUM — без надобности не вписывать).
# Каталог сайта читается учёткой WESTMED_* (админ-API).
# PRODUCT_WATCH_ENABLED пустым не оставлять (Invalid boolean value []); остальные ключи без надобности не вписывать.
PRODUCT_WATCH_ENABLED=false
TELEGRAM_PRODUCTS_THREAD_ID=CHANGE_ME_topic_id   # id темы «Тендеры (наши товары)» — только цифры (https://t.me/c/4352219740/<id>)
# Итоги тендеров goszakup, «📞 Звонить заказчику» и цены рынка из договоров (DEPLOY.md §12): сообщения — в тему «Тендеры»
# (чужие лоты ЗКО, тихо) и «Тендеры (наши товары)» (наши — со звуком, сводка дня — тихо). Нужны TENDERS_NOTIFY_ENABLED и GOSZAKUP_TOKEN.
# Ключи пустыми не вписывать: пустой TENDER_RESULTS_ENABLED роняет старт (Invalid boolean value []); расписания без надобности
# не нужны (пусто — проход ежечасно в :50 8–20 пн–сб, сводка 9:00 пн–сб, сбор цен рынка 7:15 ежедневно; «-» выключает).
# TENDER_RESULTS_ENABLED=false
# TENDER_RESULTS_CRON=
# TENDER_RESULTS_DIGEST_CRON=
# TENDER_RESULTS_MARKET_CRON=
# Курс НБ РК сегодня (DEPLOY.md §13): закупка и прибыль «по курсу сегодня»; наш курс вписывается на странице «Курсы валют».
# Ключ пустым не вписывать (пустой булев флаг роняет старт); расписание без надобности не нужно (пусто — раз в 3 часа в :07).
# RATES_NBRK_ENABLED=false

# --- Обращения: приём заявок с сайта westmed.kz (API админки сайта, код сайта не меняется) ---
# Учётка АИС на сайте создаётся одной строкой в его БД (спека §13). Пароль — только здесь.
WESTMED_LEADS_ENABLED=false
WESTMED_BASE_URL=https://westmed.kz
WESTMED_USERNAME=ais@westmed.kz
WESTMED_PASSWORD=CHANGE_ME_westmed_integration_password
WESTMED_WRITE_STATUS=true

# --- Чаты WhatsApp (зеркало переписки рабочего номера; DEPLOY.md §7) ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=waha            # waha — свой шлюз в Docker (по умолчанию); greenapi — запасной
WHATSAPP_MAX_FILE_MB=25
# WAHA: оба ключа — `openssl rand -hex 32` прямо на сервере, в чат не печатать.
# COMPOSE_PROFILES=whatsapp запускает контейнер ais-waha (без этой строки обычный деплой WAHA не поднимает).
WHATSAPP_WAHA_API_KEY=CHANGE_ME_openssl_rand_hex_32
WHATSAPP_WAHA_HMAC_KEY=CHANGE_ME_openssl_rand_hex_32
#COMPOSE_PROFILES=whatsapp
# Green-API (запасной, WHATSAPP_PROVIDER=greenapi): инстанс Business, адрес вебхука в кабинете — ПУСТОЙ.
# Токен стоит в пути URL запросов — нигде не печатать.
WHATSAPP_API_URL=CHANGE_ME_apiUrl_from_green_api_cabinet   # вида https://7105.api.greenapi.com
WHATSAPP_ID_INSTANCE=CHANGE_ME_idInstance
WHATSAPP_API_TOKEN=CHANGE_ME_apiTokenInstance
